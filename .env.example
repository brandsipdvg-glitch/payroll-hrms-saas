# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payroll_hrms?schema=public"

# --- Auth (NextAuth.js v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-64-char-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
NEXT_PUBLIC_APP_NAME="PayrollHRM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Uploads ---
# Directory where uploaded employee documents are stored
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB="10"